    { "binding": "SHARD_05", "database_name": "d1-fabric-shard-05", "database_id": "61df0724-e2b4-42fa-913c-b890ced4a1d6" },
    { "binding": "SHARD_06", "database_name": "d1-fabric-shard-06", "database_id": "a4abacd7-d76b-45fd-a391-4c6fac39b55f" },
