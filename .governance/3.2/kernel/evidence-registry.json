{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registry_id": "REGISTRY-3.2-EVIDENCE",
  "registry_version": "1.3.0",
  "policy_generation": 1,
  "active_governance_policy_version": "3.2.6",
  "status": "ACTIVE",
  "authority_source": "docs/D1-FABRIC-3.2.6-GOVERNANCE-KERNEL-META-CONTRACT-v1.0.md",
  "records": [],
  "required_record_fields": [
    "evidence_id", "change_id", "commit", "registry_generation", "policy_version",
    "environment", "probe", "test_identity", "scope", "artifacts", "ci_run", "ci_workflow",
    "ci_job", "gate", "gate_result", "admission_decision", "result", "started_at", "finished_at",
    "verifier", "expires_at", "dag_edges"
  ],
  "record_integrity_rules": [
    "evidence_id_must_be_unique",
    "change_id_must_be_known",
    "commit_must_be_full_sha_and_exist",
    "ci_run_must_be_identifiable_and_bound_to_current_commit",
    "ci_workflow_and_ci_job_must_be_identifiable",
    "registry_generation_must_match_policy_generation",
    "policy_version_must_match_active_governance_policy",
    "test_identity_and_scope_must_be_explicit",
    "artifacts_must_be_present_reproducible_and_sha256_bound",
    "gate_must_be_identifiable_and_gate_result_must_be_pass",
    "kernel_structural_gate_must_only_decide_kernel_verified",
    "architecture_admission_must_remain_blocked_until_final_architecture_gate",
    "result_must_be_pass_for_pass_evidence",
    "finished_at_must_not_precede_started_at",
    "expires_at_must_be_after_finished_at_and_current_time",
    "dag_edges_must_form_complete_terminal_chain"
  ],
  "empty_registry_meaning": "NOT_PASS; no current evidence exists for architecture admission",
  "historical_policy": "evidence produced under superseded governance cannot satisfy current admission without explicit revalidation"
}
