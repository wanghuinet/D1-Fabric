{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d1-fabric://governance/3.2/kernel/contract-metadata.schema.json",
  "title": "D1-Fabric 3.2 Contract Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "status",
    "authority_level",
    "owner",
    "scope",
    "parent_contracts",
    "supersedes",
    "invariants",
    "machine_rules",
    "evidence_requirements",
    "lifecycle",
    "conflict_policy"
  ],
  "properties": {
    "contract_id": { "type": "string", "pattern": "^CONTRACT-[A-Z0-9._-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "review", "active", "superseded", "retired"] },
    "authority_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "owner": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "parent_contracts": { "type": "array", "items": { "type": "string", "pattern": "^CONTRACT-[A-Z0-9._-]+$" } },
    "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^CONTRACT-[A-Z0-9._-]+$" } },
    "invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "machine_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "lifecycle": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "conflict_policy": { "const": "explicit" }
  }
}
