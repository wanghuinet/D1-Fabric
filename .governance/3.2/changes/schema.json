{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["change_id","actor","target_environment","risk","owners","capabilities","resources","files","policy_version","verification_plan","recovery_class","expiry"],
  "properties": {
    "change_id": {"type":"string","minLength":1},
    "actor": {"type":"object","required":["type","id"],"properties":{"type":{"enum":["human","automation","ai"]},"id":{"type":"string"}},"additionalProperties":false},
    "target_environment": {"enum":["dev","test","staging","production"]},
    "risk": {"enum":["routine","controlled","high-risk","emergency"]},
    "owners": {"type":"array","minItems":1,"items":{"type":"string"}},
    "capabilities": {"type":"array","items":{"type":"string"}},
    "resources": {"type":"array","items":{"type":"string"}},
    "files": {"type":"array","items":{"type":"string"}},
    "policy_version": {"type":"string","minLength":1},
    "verification_plan": {"type":"array","minItems":1,"items":{"type":"string"}},
    "recovery_class": {"enum":["routine","controlled","high-risk","emergency"]},
    "expiry": {"type":"string","minLength":1}
  },
  "additionalProperties": true
}
