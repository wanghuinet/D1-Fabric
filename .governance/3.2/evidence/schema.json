{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["evidence_id","change_id","commit","registry_generation","policy_version","environment","probe","result","started_at","finished_at","verifier","expires_at"],
  "properties": {
    "evidence_id":{"type":"string","minLength":1},
    "change_id":{"type":"string","minLength":1},
    "commit":{"type":"string","minLength":7},
    "registry_generation":{"type":"string","minLength":1},
    "policy_version":{"type":"string","minLength":1},
    "environment":{"type":"string","minLength":1},
    "probe":{"type":"string","minLength":1},
    "result":{"enum":["pass","fail","waived"]},
    "started_at":{"type":"string","minLength":1},
    "finished_at":{"type":"string","minLength":1},
    "verifier":{"type":"string","minLength":1},
    "expires_at":{"type":"string","minLength":1},
    "artifacts":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}
